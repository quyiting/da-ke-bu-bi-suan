<view class="page-shell profile-page">
  <view class="page-heading">
    <view class="profile-title-row">
      <view class="hero-title">我的记录</view>
      <view class="capacity-summary">{{capacity.total}} / {{capacity.limit}} 条</view>
    </view>
    <view class="hero-copy">回看当时的想法，记下后来的故事。</view>
    <view class="capacity-notice" wx:if="{{capacity.isNearLimit}}">{{capacity.isFull ? "记录已满，下次保存前会询问是否替换最久未更新的一条。" : "还可保存 " + capacity.remaining + " 条，可以删除不需要的记录。"}}</view>
  </view>

  <view class="filter-row">
    <button wx:for="{{filterOptions}}" wx:key="id" class="filter-chip {{activeFilter === item.id ? 'active' : ''}}" data-filter="{{item.id}}" bindtap="setFilter" aria-pressed="{{activeFilter === item.id}}">{{item.label}}</button>
  </view>

  <view class="history-stack" wx:if="{{filteredHistory.length}}">
    <view class="history-item" wx:for="{{filteredHistory}}" wx:key="id">
      <view class="history-item-head">
        <view class="history-type">{{item.typeLabel}} · {{item.dateLabel}}</view>
        <view class="history-status" wx:if="{{item.type === 'yao'}}">{{item.reviewLabel}}</view>
      </view>
      <view class="history-title">{{item.question || item.title}}</view>
      <view class="history-subtitle" wx:if="{{item.question}}">{{item.title}}</view>
      <view class="history-summary {{!item.hasResult ? 'history-summary-full' : ''}}">{{item.summary}}</view>
      <view class="history-note-preview" wx:if="{{item.reviewNote && expandedReviewId !== item.id}}">回访：{{item.reviewNote}}</view>
      <view class="history-actions">
        <button wx:if="{{item.hasResult}}" class="text-button history-open" data-id="{{item.id}}" bindtap="handleOpenRecord">查看结果</button>
        <view wx:else class="legacy-note">仅保存了摘要</view>
        <button wx:if="{{item.type === 'yao'}}" class="text-button" data-id="{{item.id}}" bindtap="handleReviewToggle" aria-expanded="{{expandedReviewId === item.id}}">{{expandedReviewId === item.id ? '收起回访' : '回访'}}</button>
        <button class="text-button delete-button" data-id="{{item.id}}" bindtap="handleDeleteRecord">删除</button>
      </view>
      <view class="review-panel" wx:if="{{item.type === 'yao' && expandedReviewId === item.id}}">
        <view class="section-mini">后来怎么样了？</view>
        <view class="review-row">
          <button wx:for="{{reviewOptions}}" wx:for-item="option" wx:key="id" class="review-chip {{item.reviewStatus === option.id ? 'active' : ''}}" data-id="{{item.id}}" data-status="{{option.id}}" bindtap="handleReviewStatus" aria-pressed="{{item.reviewStatus === option.id}}">{{option.label}}</button>
        </view>
        <view class="review-note-display" wx:if="{{item.reviewNote}}"><view class="review-note-copy">{{item.reviewNote}}</view></view>
        <view class="subtle-note" wx:if="{{item.reviewUpdatedLabel}}">更新于 {{item.reviewUpdatedLabel}}</view>
        <button class="secondary-button review-note-edit" data-id="{{item.id}}" bindtap="handleEditReviewNote">{{item.reviewNote ? '编辑回访备注' : '添加回访备注'}}</button>
      </view>
    </view>
  </view>
  <view class="empty-state" wx:else>
    <view class="empty-title">{{history.length ? '还没有这类记录' : '留住第一条记录'}}</view>
    <view class="empty-copy">{{history.length ? '切换分类，看看其他记录。' : '抽签或问事后，结果会自动保存在这里。'}}</view>
    <navigator wx:if="{{!history.length}}" class="primary-button empty-action" url="/pages/draw/draw" open-type="navigate">去抽一签</navigator>
  </view>

  <button class="text-button stats-toggle" bindtap="handleStatsToggle" aria-expanded="{{showStats}}">{{showStats ? '收起记录统计 −' : '查看记录统计 ＋'}}</button>
  <view class="panel-card stats-card" wx:if="{{showStats}}">
    <view class="section-title">记录统计</view>
    <view class="stats-grid">
      <view><view class="stat-value">{{summary.drawCount}}</view><view class="stat-label">抽签</view></view>
      <view><view class="stat-value">{{summary.yaoCount}}</view><view class="stat-label">问事</view></view>
      <view><view class="stat-value">{{summary.exploreDays}}</view><view class="stat-label">探索天数</view></view>
    </view>
    <view class="review-overview">待回看 {{summary.pendingReviewCount}} · 部分应 {{summary.partialReviewCount}} · 已应 {{summary.matchedReviewCount}} · 暂未应 {{summary.unmetReviewCount}}</view>
  </view>
  <view class="storage-footer">
    <view class="storage-note">记录仅保存在本机。换设备或清理小程序数据后，无法自动恢复。</view>
    <button wx:if="{{capacity.total}}" class="text-button delete-button clear-button" bindtap="handleClearLocal">清空本机记录</button>
  </view>
</view>
<include src="../../templates/review-note.wxml" />
