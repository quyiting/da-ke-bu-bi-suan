.page-heading {
  padding: 16rpx 4rpx 28rpx;
}
.profile-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.capacity-summary {
  color: var(--muted);
  font-size: 26rpx;
}
.capacity-notice {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 26rpx;
  line-height: 1.6;
}
.filter-row {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #eae8e4;
  margin-bottom: 24rpx;
}
.filter-chip {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 0 16rpx;
  margin: 0;
  border-radius: 12rpx;
  line-height: 44px;
  color: var(--muted);
  background: transparent;
  font-size: 28rpx;
}
.filter-chip.active {
  background: var(--surface);
  color: var(--text);
  font-weight: 600;
}
.history-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.history-item {
  padding: 28rpx 28rpx 8rpx;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  background: var(--surface);
}
.history-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}
.history-status {
  flex-shrink: 0;
  color: var(--accent);
}
.history-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 600;
  word-break: break-all;
}
.history-subtitle {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.history-summary, .history-note-preview {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}
.history-note-preview {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--soft);
}
.history-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--border);
}
.history-open {
  margin-right: auto;
}
.legacy-note {
  flex: 1;
  color: var(--muted);
  font-size: 24rpx;
}
.delete-button {
  color: #975044;
}
.review-panel {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
}
.review-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}
.review-chip {
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 0 4rpx;
  border-radius: 12rpx;
  background: var(--soft);
  color: var(--muted);
  font-size: 24rpx;
  line-height: 44px;
}
.review-chip.active {
  background: var(--accent);
  color: white;
}
.empty-state {
  padding: 76rpx 24rpx;
}
.empty-title {
  font-size: 34rpx;
  color: var(--text);
  font-weight: 600;
}
.empty-copy {
  margin-top: 16rpx;
  line-height: 1.7;
}
.empty-action {
  margin-top: 32rpx;
}
.stats-toggle {
  width: 100%;
  margin-top: 24rpx;
}
.stats-card {
  margin-top: 16rpx;
  padding: 28rpx;
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
  text-align: center;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 600;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.review-overview {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.8;
}
.storage-footer {
  margin-top: 28rpx;
  padding: 0 20rpx;
  text-align: center;
}
.storage-note {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.7;
}
.clear-button {
  margin: 12rpx auto 0;
}
.history-summary-full {
  display: block;
  overflow: visible;
}
