.ritual-panel,
.result-card {
  padding: 28rpx;
}

.ritual-panel,
.lot-stage,
.result-card {
  margin-top: 24rpx;
}

.topic-grid,
.mode-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx 0;
}

.selector-mini {
  margin-top: 28rpx;
}

.topic-chip {
  width: 48.2%;
}

.mode-chip {
  width: 31.8%;
  min-height: 44px;
}

.prompt-chip {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: var(--soft);
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.8;
}

.lot-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lot-vessel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 148rpx;
  border: 1rpx solid #ceb5a0;
  border-radius: 52rpx 52rpx 12rpx 12rpx;
  background: #f8f0e7;
  color: var(--accent);
}

.lot-vessel.is-drawing {
  animation: sway 920ms ease-in-out infinite;
}

.lot-title {
  position: relative;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.lot-caption {
  position: relative;
  max-width: 560rpx;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
  color: var(--muted);
}

.draw-button {
  width: 100%;
  margin-top: 28rpx;
}

.result-head {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.daily-date,
.daily-result-date {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.insight-card {
  padding: 24rpx;
  border-left: 4rpx solid var(--accent);
  border-radius: 0 20rpx 20rpx 0;
  background: var(--soft);
}

.insight-text {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.8;
}

.action-list {
  margin-top: 18rpx;
}

.action-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(145, 92, 52, 0.12);
}

.action-number {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--soft);
  color: var(--muted);
  text-align: center;
  font-size: 24rpx;
  line-height: 40rpx;
}

.action-copy {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.lot-level {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
}

.lot-name {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--muted);
}

.lot-context {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.result-badge {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(163, 99, 47, 0.12);
  color: var(--muted);
  font-size: 22rpx;
}

.poem-card {
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
  border-radius: 16rpx;
  background: var(--soft);
}

.poem-text {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.8;
  color: var(--muted);
}

.result-section {
  margin-top: 24rpx;
}

.meter-list {
  margin-top: 26rpx;
}

.meter-item + .meter-item {
  margin-top: 20rpx;
}

.meter-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meter-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted);
}

.meter-score {
  font-size: 22rpx;
  color: var(--muted);
}

.score-bar {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(188, 133, 84, 0.12);
}

.score-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
}

.result-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.blessing-text {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--muted);
}

@keyframes sway {
  0% {
    transform: rotate(0deg) scale(1);
  }

  25% {
    transform: rotate(-3deg) scale(1.02);
  }

  75% {
    transform: rotate(3deg) scale(1.02);
  }

  100% {
    transform: rotate(0deg) scale(1);
  }
}

.draw-hero {
  padding: 16rpx 4rpx 8rpx;
}
.topic-grid, .mode-grid {
  margin-top: 16rpx;
}
.topic-chip, .mode-chip {
  margin: 0;
  line-height: 1.5;
}
.chip-title {
  font-size: 28rpx;
  font-weight: 400;
}
.lot-stage {
  padding-top: 24rpx;
}
.result-card {
  margin-top: 0;
}
.lot-name, .poem-text, .insight-text {
  color: var(--text);
}
.lot-name {
  font-size: 40rpx;
}
.poem-card {
  background: var(--accent-soft);
}
@media (prefers-reduced-motion: reduce) { .lot-vessel.is-drawing {
  animation: none;
} }
