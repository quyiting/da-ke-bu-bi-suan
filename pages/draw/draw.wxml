<view class="page-shell draw-page">
  <view class="draw-hero" wx:if="{{!currentLot}}">
    <view class="hero-title">{{isDaily ? '今日一签' : '抽一支主题签'}}</view>
    <view class="hero-copy">{{isDaily ? '每天一句提醒，今天慢慢来。' : '选一个主题，听一句提醒。'}}</view>
    <view class="daily-date" wx:if="{{isDaily}}">{{dailyDate}}</view>
  </view>

  <view class="panel-card ritual-panel" wx:if="{{!isViewingRecord && !isDaily && !currentLot}}">
    <view class="section-mini">想问哪方面？</view>
    <view class="topic-grid">
      <button
        wx:for="{{drawTopics}}"
        wx:key="id"
        class="chip-button topic-chip {{selectedTopicId === item.id ? 'active' : ''}}"
        data-topic-id="{{item.id}}"
        bindtap="selectTopic"
          disabled="{{isDrawing}}"
          aria-pressed="{{selectedTopicId === item.id}}"
      >
        <view class="chip-title">{{item.label}}</view>
      </button>
    </view>

    <view class="section-mini selector-mini">现在的心情</view>
    <view class="mode-grid">
      <button
        wx:for="{{drawModes}}"
        wx:key="id"
        class="chip-button mode-chip {{selectedModeId === item.id ? 'active' : ''}}"
        data-mode-id="{{item.id}}"
        bindtap="selectMode"
          disabled="{{isDrawing}}"
          aria-pressed="{{selectedModeId === item.id}}"
      >
        <view class="chip-title">{{item.label}}</view>
      </button>
    </view>

  </view>

  <view class="lot-stage" wx:if="{{!isViewingRecord && !currentLot}}">
    <view class="lot-vessel {{isDrawing ? 'is-drawing' : ''}}">
      <view class="lot-title">签</view>
    </view>
    <view class="lot-caption">{{motionText}}</view>

    <button
      class="primary-button draw-button"
      bindtap="handleDraw"
      disabled="{{isDrawing}}"
      loading="{{isDrawing}}"
    >
      {{drawButtonText}}
    </button>
  </view>

  <view class="fortune-card result-card" wx:if="{{currentLot}}">
    <view class="subtle-note">{{recordSaved ? (isViewingRecord ? "正在回看当时保存的签文" : "完整签文已保存在本机记录") : (isDaily ? "今日签文未在记录中，可用海报留存" : "本机保存失败，请先保存海报留存")}}</view>
    <view class="daily-result-date" wx:if="{{currentLot.dailyDate}}">今日一签 · {{currentLot.dailyDate}}</view>
    <view class="result-head">
      <view>
        <view class="lot-level">{{currentLot.level}}</view>
        <view class="lot-name">{{currentLot.title}}</view>
        <view class="lot-context">{{currentLot.topic.label}} · {{currentLot.mode.label}}</view>
      </view>
      <view class="result-badge">{{currentLot.badge}}</view>
    </view>

    <view class="keyword-row">
      <view class="tag" wx:for="{{currentLot.resultTags}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="poem-card">
      <view class="section-mini">签文</view>
      <view class="poem-text">{{currentLot.poem}}</view>
    </view>

    <view class="result-section insight-card">
      <view class="section-mini">一句提醒</view>
      <view class="insight-text">{{currentLot.insight}}</view>
    </view>

    <view class="result-section">
      <view class="section-mini">你可以先做</view>
      <view class="action-list">
        <view class="action-item" wx:for="{{currentLot.nextActions}}" wx:key="*this">
          <view class="action-number">{{index + 1}}</view>
          <view class="action-copy">{{item}}</view>
        </view>
      </view>
    </view>

    <button class="secondary-button draw-button" bindtap="handleDetailToggle" aria-expanded="{{showDetailedResult}}">{{showDetailedResult ? "收起更多解读" : "展开更多解读"}}</button>

    <block wx:if="{{showDetailedResult}}">

    <view class="result-section">
      <view class="section-mini">再读签意</view>
      <view class="result-copy">{{currentLot.summary}}</view>
    </view>

    <view class="meter-list">
      <view class="meter-item" wx:for="{{currentLot.meters}}" wx:key="label">
        <view class="meter-top">
          <view class="meter-label">{{item.label}}</view>
          <view class="meter-score">{{item.score}}</view>
        </view>
        <view class="score-bar">
          <view class="score-fill" style="width: {{item.score}}%;"></view>
        </view>
      </view>
    </view>

    <view class="result-section">
      <view class="section-mini">今天先避开</view>
      <view class="result-copy">{{currentLot.avoid}}</view>
    </view>

    <view class="result-section">
      <view class="section-mini">再补一句提醒</view>
      <view class="result-copy">{{currentLot.ritual}}</view>
    </view>

    <view class="result-meta">
      <view class="tag">适合时段 {{currentLot.luckyMoment}}</view>
      <view class="tag">能量值 {{currentLot.intensity}}</view>
      <view class="tag">契合度 {{currentLot.resonance}}</view>
      <view class="tag">幸运色 {{currentLot.supportColor}}</view>
      <view class="tag">利方位 {{currentLot.supportDirection}}</view>
    </view>

    <view class="blessing-text">{{currentLot.blessing}}</view>
    </block>

    <view class="poster-actions">
      <button class="primary-button poster-action" bindtap="handlePosterOpen" loading="{{isPosterGenerating}}">生成海报</button>
      <button class="secondary-button poster-action" open-type="share">邀请朋友体验</button>
    </view>

    <button class="secondary-button draw-button" bindtap="handleNewDraw">{{isDaily ? "再问一支主题签" : "开始新的抽签"}}</button>
    <view class="subtle-note">内容仅供娱乐与自我探索参考。</view>
  </view>
</view>
<include src="../../templates/poster.wxml" />
