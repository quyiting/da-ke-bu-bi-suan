.page-heading {
  padding: 16rpx 4rpx 32rpx;
}
.daily-card {
  padding: 32rpx;
  border: 1rpx solid #e9e1d9;
  border-radius: 24rpx;
  background: #f8f0e7;
  text-align: center;
}
.daily-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.daily-date {
  color: var(--muted);
  font-size: 24rpx;
}
.daily-symbol {
  width: 72rpx;
  height: 104rpx;
  margin: 32rpx auto 24rpx;
  border: 1rpx solid #ceb5a0;
  border-radius: 36rpx 36rpx 10rpx 10rpx;
  color: var(--accent);
  font-size: 34rpx;
  line-height: 104rpx;
}
.daily-title {
  font-size: 38rpx;
  line-height: 1.5;
  font-weight: 600;
}
.daily-copy {
  max-width: 540rpx;
  margin: 16rpx auto 32rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-line;
}
.daily-action {
  width: 100%;
}
.home-entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 24rpx;
}
.entry-button {
  width: 100%;
  margin: 0;
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  background: var(--surface);
  text-align: left;
  line-height: 1.5;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
}
.entry-arrow {
  float: right;
  color: var(--muted);
}
.entry-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}
.recent-section {
  margin-top: 36rpx;
}
.recent-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.recent-card {
  width: 100%;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  text-align: left;
  line-height: 1.6;
}
.recent-title {
  font-size: 30rpx;
  font-weight: 600;
}
.recent-copy {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
}
.recent-action {
  margin-top: 20rpx;
  color: var(--accent);
  font-size: 26rpx;
}
.home-note {
  margin-top: 36rpx;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}
