.hero-panel,
.recommend-card,
.today-card,
.ritual-card,
.recent-card {
  padding: 38rpx 30rpx;
}

.recommend-card,
.today-card,
.section-header,
.feature-list,
.journey-list,
.ritual-card,
.recent-card {
  margin-top: 24rpx;
}

.hero-metrics {
  margin-top: 28rpx;
}

.hero-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.hero-action {
  flex: 1;
}

.today-quote {
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #3f2a1d;
}

.today-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.today-source {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8b694f;
}

.recommend-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #372317;
}

.recommend-action {
  margin-top: 26rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feature-item {
  display: block;
  padding: 30rpx 28rpx;
}

.feature-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(200, 136, 69, 0.14);
  color: #9a602f;
  font-size: 22rpx;
}

.feature-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #322117;
}

.feature-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #684d3c;
}

.feature-footer {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #af6630;
}

.journey-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.journey-item {
  display: block;
  padding: 30rpx 28rpx;
}

.journey-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #322116;
}

.journey-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #6b4f3c;
}

.journey-action {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a96535;
}

.ritual-list {
  margin-top: 18rpx;
}

.ritual-item {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
}

.ritual-item + .ritual-item {
  border-top: 1rpx solid rgba(136, 92, 59, 0.08);
}

.ritual-index {
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 50%;
  background: rgba(168, 79, 44, 0.11);
  color: #9a5d2e;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.ritual-body {
  flex: 1;
}

.ritual-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3a271b;
}

.ritual-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #755844;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.recent-time {
  font-size: 22rpx;
  color: #8b694f;
}

.recent-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #352316;
}

.recent-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a26433;
}

.recent-summary {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #654a38;
}

.profile-action {
  margin-top: 26rpx;
}
