.ask-hero,
.recent-card {
  padding: 38rpx 30rpx;
}

.ask-hero {
  background:
    radial-gradient(circle at top right, rgba(212, 159, 91, 0.22) 0%, rgba(212, 159, 91, 0) 34%),
    linear-gradient(180deg, rgba(255, 250, 241, 0.98) 0%, rgba(247, 237, 221, 0.98) 100%);
  border-color: rgba(145, 92, 52, 0.18);
}

.brand-cover {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 24rpx 24rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 238, 0.98) 0%, rgba(244, 228, 201, 0.98) 100%);
  border: 1rpx solid rgba(145, 92, 52, 0.12);
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #9d4d2d 0%, #c78947 100%);
  color: #fff9f2;
  font-size: 44rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(130, 67, 33, 0.16);
}

.brand-copy-wrap {
  flex: 1;
  min-width: 0;
}

.brand-name {
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #2f1f18;
}

.brand-tagline {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7a5840;
}

.recent-card {
  margin-top: 24rpx;
}

.hero-promise-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-promise-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 228, 0.92);
  color: #8c5a31;
  font-size: 22rpx;
}

.home-entry-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.daily-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(168, 79, 44, 0.18);
  border-radius: 24rpx;
  background: #fffaf3;
}

.daily-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.daily-date {
  color: #795a43;
  font-size: 22rpx;
}

.daily-title {
  margin-top: 18rpx;
  color: #372317;
  font-size: 34rpx;
  font-weight: 700;
}

.daily-copy {
  margin-top: 12rpx;
  color: #654a38;
  font-size: 26rpx;
  line-height: 1.8;
}

.daily-action {
  margin-top: 24rpx;
}

.home-entry-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.shortcut-heading {
  margin-top: 28rpx;
}

.starter-panel {
  margin-top: 24rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 248, 238, 0.92);
  border: 1rpx solid rgba(146, 86, 35, 0.08);
}

.starter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.starter-kicker {
  font-size: 22rpx;
  color: #9a612f;
}

.starter-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #372317;
}

.starter-quote {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #6c4e39;
}

.start-button {
  width: 100%;
  margin-top: 24rpx;
  box-shadow: 0 14rpx 28rpx rgba(130, 67, 33, 0.16);
}

.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.home-shortcuts {
  margin-top: 28rpx;
}

.shortcut-item {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 235, 0.92);
  border: 1rpx solid rgba(146, 86, 35, 0.1);
}

.shortcut-item.active {
  background: linear-gradient(135deg, #a84f2c 0%, #c68845 100%);
  border-color: transparent;
  box-shadow: 0 14rpx 32rpx rgba(130, 67, 33, 0.16);
}

.shortcut-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #372317;
  line-height: 1.4;
}

.shortcut-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #795a43;
}

.shortcut-item.active .shortcut-title,
.shortcut-item.active .shortcut-copy {
  color: #fff8f1;
}

.mini-link-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 18rpx;
}

.mini-link-card {
  flex: 1;
  padding: 22rpx 20rpx;
  background: rgba(255, 249, 240, 0.96);
}

.recent-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #372317;
}

.recent-copy {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #654a38;
}

.recent-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recent-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(168, 79, 44, 0.12);
  color: #a0502d;
  font-size: 20rpx;
}

.recent-action {
  width: 100%;
  margin-top: 26rpx;
}

.utility-grid {
  display: flex;
  gap: 18rpx;
}

.utility-item {
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 235, 0.92);
}

.utility-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #332115;
}

.utility-action {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #af6630;
}

.summary-strip {
  margin-top: 20rpx;
}

.hero-metrics {
  margin-top: 24rpx;
}
