<view class="page-shell index-page">
  <view class="page-heading">
    <view class="hero-title">给自己一点时间</view>
    <view class="hero-copy">抽一签，问一事，记下此刻。</view>
  </view>

  <view class="daily-card">
    <view class="daily-card-head">
      <view class="section-mini">今日一签</view>
      <view class="daily-date">{{dailyCard.date}}</view>
    </view>
    <view class="daily-symbol" aria-hidden="true">签</view>
    <view class="daily-title">{{dailyCard.title}}</view>
    <view class="daily-copy">{{dailyCard.copy}}</view>
    <button class="primary-button daily-action" bindtap="handleOpenDaily">{{dailyCard.action}}</button>
  </view>

  <view class="home-entry-grid">
    <button class="entry-button" bindtap="handleOpenDraw">
      <view class="entry-title">主题抽签 <text class="entry-arrow">›</text></view>
      <view class="entry-copy">为在意的事找一句提醒</view>
    </button>
    <button class="entry-button" bindtap="handleOpenYao">
      <view class="entry-title">六爻问事 <text class="entry-arrow">›</text></view>
      <view class="entry-copy">带着一个具体问题来</view>
    </button>
  </view>

  <view class="recent-section" wx:if="{{hasHistory}}">
    <view class="recent-heading">
      <view class="section-title">最近记录</view>
      <navigator class="text-link" url="/pages/profile/profile" open-type="switchTab">查看全部 ›</navigator>
    </view>
    <button class="recent-card" bindtap="handleOpenRecent">
      <view class="recent-title">{{recentCard.title}}</view>
      <view class="recent-copy">{{recentCard.body}}</view>
      <view class="recent-action">{{recentCard.actionLabel}} ›</view>
    </button>
  </view>
  <view class="home-note">免费体验 · 记录仅保存在本机</view>
</view>
