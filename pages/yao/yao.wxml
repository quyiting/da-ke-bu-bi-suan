<view class="page-shell yao-page">
  <view class="hero-card yao-hero">
    <view class="hero-badge">大可不必算 · 问事</view>
    <view class="hero-title">先问一句</view>
    <view class="hero-copy">先看一句结果、一个建议和一个时间点。更细的盘，等你想看时再展开。</view>
  </view>

  <view class="panel-card selector-card" wx:if="{{!isViewingRecord && !result}}">
    <view class="selector-stage">
      <view class="selector-head">
        <view class="selector-index">01</view>
        <view class="selector-copy">
          <view class="section-mini">先选方向</view>
          <view class="selector-desc">先决定你现在更像在问关系、工作、选择，还是时机。</view>
        </view>
      </view>
      <view class="topic-grid">
        <view
          wx:for="{{yaoTopics}}"
          wx:key="id"
          class="chip-button topic-chip {{selectedTopicId === item.id ? 'active' : ''}}"
          data-topic-id="{{item.id}}"
          bindtap="selectTopic"
        >
          <view class="chip-title">{{item.label}}</view>
          <view class="chip-copy">{{item.cue}}</view>
        </view>
      </view>
    </view>

    <view class="selector-stage">
      <view class="selector-head">
        <view class="selector-index">02</view>
        <view class="selector-copy">
          <view class="section-mini">再选问法</view>
          <view class="selector-desc">把问题收到一个角度，结果会比泛泛地问更清楚。</view>
        </view>
      </view>
      <view class="guide-row compact-guide-row">
        <view
          wx:for="{{questionGuides}}"
          wx:key="id"
          class="guide-chip {{selectedGuideId === item.id ? 'active' : ''}}"
          data-guide-id="{{item.id}}"
          bindtap="applyQuestionGuide"
        >
          <view class="guide-chip-title">{{item.label}}</view>
          <view class="guide-chip-copy">{{item.cue}}</view>
        </view>
      </view>
    </view>

    <view class="selector-stage">
      <view class="selector-head">
        <view class="selector-index">03</view>
        <view class="selector-copy">
          <view class="section-mini">把问题补成一句话</view>
          <view class="selector-desc">别问太大，只问你眼前最在意的这一件事。</view>
        </view>
      </view>
      <textarea
        class="question-box"
        maxlength="60"
        placeholder="例如：这次合作还值得继续推进吗？"
        value="{{questionInput}}"
        bindinput="handleQuestionInput"
        disabled="{{isCasting}}"
      ></textarea>

      <view class="cast-panel">
        <button class="primary-button cast-button" bindtap="handleCast" disabled="{{isCasting}}" loading="{{isCasting}}">
          {{drawButtonText}}
        </button>
        <view class="subtle-note selector-tip">{{castingText}}</view>
        <view class="casting-card" wx:if="{{isCasting}}" aria-role="status" aria-label="{{castingText}}">
          <view class="casting-head">
            <view class="section-mini">从初爻，慢慢成卦</view>
            <view class="casting-count">{{castProgress}} / 6</view>
          </view>
          <view class="coin-row">
            <view class="casting-wait" wx:if="{{!castProgress}}">三枚铜钱，正在落下…</view>
            <view class="cast-coin {{item.value === 2 ? 'coin-front' : 'coin-back'}}" wx:for="{{castCoins}}" wx:key="id">{{item.label}}</view>
          </view>
          <view class="casting-stack">
            <view class="casting-line-row" wx:for="{{castingRows}}" wx:key="position">
              <view class="casting-position">{{item.positionLabel}}</view>
              <view wx:if="{{item.revealed}}" class="hex-line-box {{item.isYang ? 'yang' : 'yin'}} {{item.isMoving ? 'moving' : ''}}"></view>
              <view wx:else class="casting-placeholder"></view>
              <view class="casting-type">{{item.revealed ? item.typeLabel + (item.isMoving ? ' · 动' : '') : '待投'}}</view>
            </view>
          </view>
          <view class="subtle-note">正面记2，背面记3；6、9为动爻，由下向上记录。</view>
          <button class="secondary-button skip-cast-button" bindtap="handleSkipCast">跳过动画，看结果</button>
        </view>
      </view>
    </view>
  </view>

  <view class="fortune-card quick-result-card" wx:if="{{result}}">
    <view class="subtle-note">{{recordSaved ? (isViewingRecord ? "正在回看当时保存的结果" : "完整卦盘已保存在本机记录") : "当前结果未保存在本机，可用海报留存"}}</view>
    <view class="quick-result-top">
      <view class="quick-result-copy">
        <view class="section-mini">先看结论</view>
        <view class="result-title">{{result.decision.label}}</view>
        <view class="result-meta-top">{{result.topic.label}} · {{result.originalHexagram.title}}之{{result.changedHexagram.title}}</view>
      </view>
      <view class="oracle-seal">断</view>
    </view>

    <view class="result-question">{{result.question}}</view>
    <view class="quick-insight-card">
      <view class="section-mini">一句提醒</view>
      <view class="quick-voice">{{result.quickVoice}}</view>
      <view class="result-copy">{{result.quickLead}}</view>
    </view>

    <view class="decision-row">
      <view class="tag" wx:for="{{result.quickTags}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="formal-grid quick-grid">
      <view class="formal-box" wx:for="{{result.quickPanels}}" wx:key="label">
        <view class="formal-label">{{item.label}}</view>
        <view class="formal-value quick-value">{{item.value}}</view>
        <view class="formal-copy">{{item.copy}}</view>
      </view>
    </view>

    <view class="share-actions">
      <button class="primary-button share-button" bindtap="handleDetailToggle">
        {{showDetailedResult ? "收起详细排盘" : "展开详细排盘"}}
      </button>
      <button class="secondary-button share-button" bindtap="handlePosterOpen" loading="{{isPosterGenerating}}">
        生成海报
      </button>
    </view>
    <view class="subtle-note detail-note">想继续看世应、用神、纳甲和动爻时，再展开下面这层就够了。</view>
    <button class="secondary-button record-new-button" bindtap="handleNewQuestion">问另一件事</button>
    <view class="subtle-note">内容仅供娱乐与自我探索参考。</view>
  </view>

  <view class="panel-card knowledge-card" wx:if="{{result && hexagramKnowledge}}">
    <view class="knowledge-head">
      <view>
        <view class="section-mini">认识这卦</view>
        <view class="knowledge-title">{{hexagramKnowledge.title}}</view>
      </view>
      <view class="knowledge-order">第 {{hexagramKnowledge.order}} 卦</view>
    </view>
    <button class="secondary-button knowledge-button" bindtap="handleKnowledgeToggle">{{showHexagramKnowledge ? '收起卦象小知识' : '读原文与白话提示'}}</button>
    <view class="knowledge-body" wx:if="{{showHexagramKnowledge}}">
      <view class="section-mini">《周易》卦辞原文</view>
      <view class="knowledge-classic">{{hexagramKnowledge.guaCi}}</view>
      <view class="section-mini knowledge-plain-label">白话提示</view>
      <view class="result-copy">{{hexagramKnowledge.plainMeaning}}</view>
      <view class="subtle-note">白话提示为本项目编写，供文化阅读与自我复盘参考。</view>
    </view>
  </view>

  <block wx:if="{{result && showDetailedResult}}">
    <view class="panel-card detail-bridge">
      <view class="section-title">详细排盘</view>
      <view class="section-desc">这里再看世应、用神、纳甲、动爻和应期细断。</view>
    </view>

    <view class="fortune-card oracle-card">
      <view class="oracle-top">
        <view class="oracle-copy">
          <view class="section-mini">详细排盘</view>
          <view class="result-title">{{result.originalHexagram.title}}</view>
          <view class="result-meta-top">
            {{result.generatedAtLabel}} · {{result.relationProfile.palaceLabel}} {{result.relationProfile.palaceStage}}
          </view>
        </view>
        <view class="oracle-seal">卦</view>
      </view>

      <view class="result-question">{{result.question}}</view>
      <view class="result-copy">{{result.overview}}</view>

      <view class="decision-row">
        <view class="tag" wx:for="{{result.plateHighlights}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="oracle-visuals">
        <view class="visual-panel">
          <view class="visual-label">本卦</view>
          <view class="hex-stack">
            <view
              wx:for="{{result.visualLines.original}}"
              wx:key="id"
              class="hex-line-box {{item.isYang ? 'yang' : 'yin'}} {{item.isMoving ? 'moving' : ''}}"
            ></view>
          </view>
          <view class="visual-title">{{result.originalHexagram.title}}</view>
        </view>

        <view class="visual-divider">之</view>

        <view class="visual-panel">
          <view class="visual-label">变卦</view>
          <view class="hex-stack">
            <view
              wx:for="{{result.visualLines.changed}}"
              wx:key="id"
              class="hex-line-box {{item.isYang ? 'yang' : 'yin'}} {{item.isMoving ? 'changed' : ''}}"
            ></view>
          </view>
          <view class="visual-title">{{result.changedHexagram.title}}</view>
        </view>
      </view>
    </view>

    <view class="panel-card calendar-card">
      <view class="section-title">起卦信息</view>
      <view class="calendar-grid">
        <view class="formal-box calendar-box" wx:for="{{result.calendarPanels}}" wx:key="label">
          <view class="formal-label">{{item.label}}</view>
          <view class="formal-value">{{item.value}}</view>
          <view class="formal-copy">{{item.copy}}</view>
        </view>
      </view>
    </view>

    <view class="panel-card formal-card">
    <view class="section-title">排盘重点</view>
    <view class="formal-grid">
      <view class="formal-box">
        <view class="formal-label">世应</view>
        <view class="formal-value">{{result.relationProfile.shiLabel}}世 · {{result.relationProfile.yingLabel}}应</view>
        <view class="formal-copy">世看自己立场，应看对面与外部反馈。</view>
      </view>
      <view class="formal-box">
        <view class="formal-label">主气</view>
        <view class="formal-value">{{result.relationProfile.dominantRelation}}</view>
        <view class="formal-copy">{{result.relationProfile.dominantRelationMeaning}}</view>
      </view>
      <view class="formal-box">
        <view class="formal-label">断语</view>
        <view class="formal-value">{{result.decision.label}}</view>
        <view class="formal-copy">{{result.decision.desc}}</view>
      </view>
    </view>
    </view>

    <view class="panel-card relation-card">
    <view class="section-title">世应细断</view>
    <view class="formal-grid">
      <view class="formal-box">
        <view class="formal-label">互动关系</view>
        <view class="formal-value">{{result.shiYingProfile.relationLabel}}</view>
        <view class="formal-copy">{{result.shiYingProfile.relationTone}}</view>
      </view>
      <view class="formal-box">
        <view class="formal-label">谁先动</view>
        <view class="formal-value">{{result.shiYingProfile.motionLabel}}</view>
        <view class="formal-copy">{{result.shiYingProfile.motionTone}}</view>
      </view>
      <view class="formal-box">
        <view class="formal-label">强弱位</view>
        <view class="formal-value">{{result.shiYingProfile.balanceLabel}}</view>
        <view class="formal-copy">{{result.shiYingProfile.balanceTone}}</view>
      </view>
    </view>
    <view class="result-copy">{{result.shiYingProfile.summary}}</view>
    </view>

    <view class="panel-card pattern-card" wx:if="{{result.patternProfile.primaryLabel}}">
    <view class="section-title">反伏与进退</view>
    <view class="formal-box">
      <view class="formal-label">格局</view>
      <view class="formal-value">{{result.patternProfile.primaryLabel}}</view>
      <view class="formal-copy">{{result.patternProfile.summary}}</view>
    </view>
    <view class="moving-list" wx:if="{{result.patternProfile.items.length > 1}}">
      <view class="moving-item" wx:for="{{result.patternProfile.items}}" wx:key="label">
        <view class="moving-title">{{item.label}}</view>
        <view class="moving-body">{{item.summary}}</view>
      </view>
    </view>
    </view>

    <view class="panel-card timing-card" wx:if="{{result.timingProfile.items.length}}">
    <view class="section-title">应期细断</view>
    <view class="formal-box">
      <view class="formal-label">主看</view>
      <view class="formal-value">{{result.timingProfile.primaryLabel}}</view>
      <view class="formal-copy">{{result.timingProfile.summary}}</view>
    </view>
    <view class="moving-list">
      <view class="moving-item" wx:for="{{result.timingProfile.items}}" wx:key="label">
        <view class="moving-title">{{item.label}}</view>
        <view class="moving-body">{{item.body}}</view>
        <view class="subtle-note" wx:if="{{item.nearLabel}}">近应日：{{item.nearLabel}}</view>
        <view class="subtle-note" wx:if="{{item.farLabel}}">远应月：{{item.farLabel}}</view>
      </view>
    </view>
    </view>

    <view class="panel-card timeline-card" wx:if="{{result.timingProfile.timeline.length}}">
    <view class="section-title">应期时间轴</view>
    <view class="section-desc">先盯最近会应的日点，再看后面会转开的月令。</view>
    <view class="timeline-list">
      <view class="timeline-item" wx:for="{{result.timingProfile.timeline}}" wx:key="id">
        <view class="timeline-rail">
          <view class="timeline-dot {{item.scope}}"></view>
          <view class="timeline-line" wx:if="{{index !== result.timingProfile.timeline.length - 1}}"></view>
        </view>
        <view class="timeline-card-box">
          <view class="timeline-meta">
            <view class="tag">{{item.scopeLabel}}</view>
            <view class="timeline-date">{{item.label}}</view>
          </view>
          <view class="timeline-title">{{item.title}}</view>
          <view class="timeline-copy">{{item.sourceLabel}}</view>
        </view>
      </view>
    </view>
    </view>

    <view class="panel-card yong-card">
    <view class="section-title">用神提要</view>
    <view class="formal-label">{{result.yongShenProfile.label}}</view>
    <view class="formal-value">{{result.yongShenProfile.verdictLabel}}</view>
    <view class="result-copy">{{result.yongShenProfile.verdictBody}}</view>

    <view class="yong-list" wx:if="{{result.yongShenProfile.candidates.length}}">
      <view class="yong-item" wx:for="{{result.yongShenProfile.candidates}}" wx:key="id">
        <view class="yong-head">
          <view class="yong-title">{{item.title}}</view>
          <view class="yong-tags">
            <view class="tag" wx:if="{{item.source === 'hidden'}}">伏神</view>
            <view class="tag">{{item.powerLabel}}</view>
          </view>
        </view>
        <view class="yong-copy">{{item.summary}}</view>
        <view class="subtle-note" wx:if="{{item.hostTitle}}">所伏之处：{{item.hostTitle}}</view>
      </view>
    </view>
    </view>

    <view class="panel-card hidden-card" wx:if="{{result.formalLines.hiddenLines.length}}">
    <view class="section-title">伏神与暗线</view>
    <view class="moving-list">
      <view class="moving-item" wx:for="{{result.formalLines.hiddenLines}}" wx:key="id">
        <view class="moving-title">{{item.title}}</view>
        <view class="moving-prompt">伏在 {{item.hostTitle || item.hostPositionLabel}}</view>
        <view class="moving-body">{{item.summary}}。{{item.relationMeaning}}</view>
        <view class="subtle-note" wx:if="{{item.graveVoidLabel}}">墓绝空破：{{item.graveVoidLabel}}</view>
      </view>
    </view>
    </view>

    <view class="panel-card plate-card">
    <view class="section-title">纳甲六爻盘</view>
    <scroll-view class="plate-scroll" scroll-x>
      <view class="plate-table">
        <view class="plate-header">
          <view class="plate-col spirit-col">六神/六兽</view>
          <view class="plate-col najia-col">纳甲</view>
          <view class="plate-col relation-col">六亲</view>
          <view class="plate-col hidden-col">伏神</view>
          <view class="plate-col state-col">旺衰</view>
          <view class="plate-col line-col">本爻</view>
          <view class="plate-col role-col">世应</view>
          <view class="plate-col changed-col">变爻</view>
        </view>

        <view class="plate-row" wx:for="{{result.formalLines.rows}}" wx:key="id">
          <view class="plate-col spirit-col">
            <view class="spirit-name">{{item.spirit}}</view>
            <view class="spirit-pos">{{item.positionLabel}}</view>
          </view>

          <view class="plate-col najia-col">
            <view class="relation-name">{{item.naJia}}</view>
            <view class="relation-element">{{item.element}}</view>
          </view>

          <view class="plate-col relation-col">
            <view class="relation-name">{{item.relation}}</view>
            <view class="relation-element">{{item.powerLabel}}</view>
          </view>

          <view class="plate-col hidden-col">
            <view class="hidden-name">{{item.hiddenLabel || '—'}}</view>
            <view class="relation-element" wx:if="{{item.hiddenItems.length}}">{{item.hiddenItems[0].powerLabel}}</view>
          </view>

          <view class="plate-col state-col">
            <view class="state-pill {{item.powerScore >= 3 ? 'strong' : item.powerScore < 0 ? 'weak' : 'mid'}}">
              {{item.monthStateLabel}}
            </view>
            <view class="spirit-pos">{{item.monthEffectLabel}} · {{item.dayEffectLabel}}</view>
            <view class="spirit-pos" wx:if="{{item.graveVoidLabel}}">{{item.graveVoidLabel}}</view>
            <view class="spirit-pos" wx:if="{{item.transitionLabel}}">{{item.transitionLabel}}</view>
          </view>

          <view class="plate-col line-col">
            <view class="plate-line {{item.isYang ? 'yang' : 'yin'}} {{item.isMoving ? 'moving' : ''}}"></view>
            <view class="line-caption">{{item.typeLabel}}</view>
          </view>

          <view class="plate-col role-col">
            <view class="role-badge {{item.hasRole ? 'active' : ''}}">{{item.roleDisplay}}</view>
          </view>

          <view class="plate-col changed-col">
            <view class="plate-line {{item.changedIsYang ? 'yang' : 'yin'}} {{item.isMoving ? 'changed' : ''}}"></view>
            <view class="line-caption">
              {{item.changedNaJia}} {{item.changedRelation}}<text
                wx:if="{{item.changedLifeStageLabel === '墓' || item.changedLifeStageLabel === '绝'}}"
              >
                · {{item.changedLifeStageLabel}}
              </text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    </view>

    <view class="panel-card moving-card" wx:if="{{result.hasMovingLines}}">
    <view class="section-title">动爻提醒</view>
    <view class="moving-list">
      <view class="moving-item" wx:for="{{result.movingLines}}" wx:key="label">
        <view class="moving-title">{{item.label}}</view>
        <view class="moving-prompt">{{item.prompt}}</view>
        <view class="moving-body">{{item.body}}</view>
      </view>
    </view>
    </view>

    <view class="checklist-grid">
    <view class="panel-card checklist-card" wx:for="{{result.reportSections}}" wx:key="title">
      <view class="section-title">{{item.title}}</view>
      <view class="result-copy">{{item.body}}</view>
    </view>
    </view>

    <view class="panel-card advice-card">
    <view class="section-title">这卦给你的行动建议</view>
    <view class="bullet-list">
      <view class="bullet-item" wx:for="{{result.nextActions}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="subtle-note">应期提醒：{{result.timingHint}}</view>
    </view>
  </block>

  <view class="panel-card followup-card" wx:if="{{result && recordSaved}}">
    <view class="section-title">结果回访</view>
    <view class="followup-head">
      <view class="tag review-tag {{activeReviewTone}}">{{activeReviewLabel}}</view>
      <view class="subtle-note">这条卦已经保存到“我的记录”，后面可以回来改成已应、部分应或暂未应。</view>
    </view>
    <view class="review-row">
      <view
        wx:for="{{reviewOptions}}"
        wx:key="id"
        class="review-chip {{activeReviewStatus === item.id ? 'active' : ''}}"
        data-status="{{item.id}}"
        bindtap="handleReviewStatus"
      >
        {{item.label}}
      </view>
    </view>
    <view class="review-note-display" wx:if="{{activeReviewNote}}">
      <view class="section-mini">回访备注</view>
      <view class="review-note-copy">{{activeReviewNote}}</view>
    </view>
    <view class="subtle-note" wx:if="{{activeReviewUpdatedLabel}}">最近回访于 {{activeReviewUpdatedLabel}}</view>
    <button class="secondary-button review-note-edit" bindtap="handleEditReviewNote">{{activeReviewNote ? "编辑回访备注" : "添加回访备注"}}</button>
  </view>

</view>
<include src="../../templates/poster.wxml" />
<include src="../../templates/review-note.wxml" />
