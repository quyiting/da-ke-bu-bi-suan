page {
  min-height: 100%;
  background:
    radial-gradient(circle at top, #fff6e8 0%, #f5ecdd 42%, #e7d4b2 100%);
  color: #2b1f18;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 176rpx;
}

.hero-card,
.feature-card,
.fortune-card,
.history-card,
.panel-card {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 250, 241, 0.9);
  border: 1rpx solid rgba(126, 77, 46, 0.14);
  box-shadow: 0 18rpx 38rpx rgba(77, 45, 24, 0.08);
}

.hero-card::after,
.feature-card::after,
.fortune-card::after,
.history-card::after,
.panel-card::after {
  content: "";
  position: absolute;
  inset: auto -24rpx -32rpx auto;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(207, 158, 95, 0.12);
  filter: blur(8rpx);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3f2415;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #70533f;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 160ms ease;
}

.primary-button {
  background: linear-gradient(135deg, #a84f2c 0%, #c68845 100%);
  color: #fff9f2;
}

.secondary-button {
  background: rgba(255, 247, 235, 0.92);
  color: #8a562b;
  border: 1rpx solid rgba(138, 86, 43, 0.16);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(161, 108, 56, 0.11);
  color: #925623;
  font-size: 22rpx;
}

.empty-state {
  padding: 60rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7f6653;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(146, 86, 35, 0.12);
  color: #8c5325;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 54rpx;
  line-height: 1.18;
  font-weight: 700;
  color: #2c1d15;
}

.hero-copy {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.85;
  color: #674d3c;
}

.section-mini {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #9c602f;
}

.result-copy {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #584030;
}

.keyword-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.subtle-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #89684f;
}

.metric-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric-box {
  flex: 1;
  min-width: 170rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 246, 233, 0.9);
}

.metric-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #382419;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #876347;
}

.chip-button {
  box-sizing: border-box;
  padding: 18rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 248, 238, 0.9);
  border: 1rpx solid rgba(146, 86, 35, 0.12);
}

.chip-button.active {
  background: linear-gradient(135deg, #a84f2c 0%, #c68845 100%);
  border-color: transparent;
  box-shadow: 0 14rpx 30rpx rgba(130, 67, 33, 0.16);
}

.chip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #382519;
}

.chip-copy {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a5d48;
}

.chip-button.active .chip-title,
.chip-button.active .chip-copy {
  color: #fff8f1;
}

.bullet-list {
  margin-top: 18rpx;
}

.bullet-item {
  position: relative;
  padding-left: 24rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #654a38;
}

.bullet-item + .bullet-item {
  margin-top: 12rpx;
}

.bullet-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b86f3b;
}

button.primary-button,
button.secondary-button {
  line-height: 88rpx;
  border: none;
}

button.primary-button::after,
button.secondary-button::after {
  border: none;
}
