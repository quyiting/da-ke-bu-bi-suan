page {
  --canvas: #f7f7f4;
  --surface: #ffffff;
  --soft: #f4f3ef;
  --text: #292824;
  --muted: #6e6a63;
  --accent: #995239;
  --accent-soft: #f4e9e2;
  --border: #e8e6e0;
  min-height: 100%;
  background: var(--canvas);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  max-width: 900rpx;
  margin: 0 auto;
}

.hero-card, .feature-card, .fortune-card, .history-card, .panel-card {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
}

button { color: inherit; }
button::after { border: none; }
button[disabled] { opacity: 0.65; }
.button-hover { opacity: 0.75; }
.text-button, .text-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  border-radius: 12rpx;
  color: var(--accent);
  font-size: 26rpx;
  line-height: 1.5;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.primary-button {
  background: var(--accent);
  color: #fff9f2;
}

.secondary-button {
  background: var(--soft);
  color: var(--muted);
  border: 1rpx solid rgba(138, 86, 43, 0.16);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(161, 108, 56, 0.11);
  color: var(--muted);
  font-size: 24rpx;
}

.empty-state {
  padding: 60rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(146, 86, 35, 0.12);
  color: var(--muted);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 0;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 700;
  color: var(--text);
}

.hero-copy {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--muted);
}

.section-mini {
  font-size: 24rpx;
  letter-spacing: 0;
  color: var(--muted);
}

.result-copy {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--muted);
}

.keyword-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.subtle-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.metric-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric-box {
  flex: 1;
  min-width: 170rpx;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 246, 233, 0.9);
}

.metric-value {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}

.metric-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.chip-button {
  box-sizing: border-box;
  min-height: 44px;
  padding: 20rpx 12rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--soft);
  border: 1rpx solid rgba(146, 86, 35, 0.12);
}

.chip-button.active {
  background: var(--accent);
  border-color: transparent;

}

.chip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.chip-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}

.chip-button.active .chip-title,
.chip-button.active .chip-copy {
  color: #fff8f1;
}

.bullet-list {
  margin-top: 18rpx;
}

.bullet-item {
  position: relative;
  padding-left: 24rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--muted);
}

.bullet-item + .bullet-item {
  margin-top: 12rpx;
}

.bullet-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b86f3b;
}

button.primary-button,
button.secondary-button {
  line-height: 1.5;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  border: none;
}

button.primary-button::after,
button.secondary-button::after {
  border: none;
}

.poster-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.poster-action {
  flex: 1;
  min-width: 0;
}

.record-new-button,
.history-open-button {
  width: 100%;
  margin-top: 24rpx;
}

.poster-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(42, 25, 16, 0.48);
}

.poster-sheet {
  width: 100%;
  max-height: 88vh;
  padding: 34rpx 28rpx 36rpx;
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 28rpx;
  background: var(--surface);
}

.poster-image {
  width: 100%;
  margin-top: 22rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 38rpx rgba(77, 45, 24, 0.12);
}

.poster-loading {
  margin-top: 22rpx;
  padding: 90rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 235, 0.9);
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 620px;
  height: 1080px;
}

.review-note-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
  background: rgba(42, 25, 16, 0.48);
}

.review-note-sheet {
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: var(--surface);
}

.review-note-input {
  width: 100%;
  height: 220rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: var(--soft);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.7;
}

.review-note-counter {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.review-note-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.review-note-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.review-note-display {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--soft);
}

.review-note-copy {
  margin-top: 10rpx;
  white-space: pre-wrap;
  word-break: break-all;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.review-note-edit {
  width: 100%;
  margin-top: 18rpx;
}

@media (prefers-reduced-motion: reduce) {
  .primary-button, .secondary-button { transition: none; }
}
